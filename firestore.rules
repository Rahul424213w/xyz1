rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registrations collection: teams submit registrations securely
    match /registrations/{registrationId} {
      // Allow legitimate registration creation with schema validation
      allow create: if request.resource.data.registrationId == registrationId
                    && request.resource.data.teamName is string
                    && request.resource.data.teamName.size() >= 2
                    && request.resource.data.leaderEmail is string
                    && request.resource.data.leaderEmail.size() >= 5
                    && request.resource.data.utr is string
                    && request.resource.data.utr.size() >= 10;

      // Allow reading team registrations for admin panel and pass lookup
      allow read: if true;

      // Allow admin updates (e.g. Approved / Rejected / Verified)
      allow update: if true;

      // Allow admin deletion (used in Team Bin permanently delete feature)
      allow delete: if true;
    }

    // Config collection for admin pin, bin pin, and admin access users
    match /config/{configId} {
      allow read, write: if true;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
